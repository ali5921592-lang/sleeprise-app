{
  "name": "sleepify-apk",
  "version": "1.0.0",
  "private": true,
  "description": "SleepRise HTML uygulamasını Android ve iOS için paketleyen Capacitor projesi.",
  "scripts": {
    "sync": "npx cap sync",
